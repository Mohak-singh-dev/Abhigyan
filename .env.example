# PostgreSQL Database Connection URL
# Replace YOUR_POSTGRES_PASSWORD with your actual local PostgreSQL postgres user password
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/abhigyan_db

# Allowed CORS Origins for the frontend (Vite dev server and preview server)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Application Environment
ENVIRONMENT=development
API_PREFIX=/api
