# ==============================================================================
# Abhigyan Environment Configuration Template
# Copy this file to `backend/.env` or `.env` in the project root.
# ==============================================================================

# Supabase PostgreSQL connection URL. Local persistent development: Session pooler.
# URL-encode reserved characters in the database password; SSL is required.
DATABASE_URL=postgresql://postgres.PROJECT-REF:YOUR-PASSWORD@YOUR-POOLER-HOST:5432/postgres?sslmode=require

# Allowed CORS Origins (comma-separated, Vite dev and preview servers)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Application Environment (development | production)
ENVIRONMENT=development

# Base API path prefix
API_PREFIX=/api

# JWT Authentication Configuration
# Local development only. Production must set a unique random secret of at least 32 characters.
JWT_SECRET_KEY=replace-with-a-random-local-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Development Demo Authentication (Must be False in production)
DEMO_AUTH_ENABLED=true
# Only set a private local demo password when you explicitly run the seed script.
DEFAULT_SEED_PASSWORD=

# AI Advisory Classifier Configuration
# Minimum confidence threshold (0.0 - 1.0) before flagging for manual human review
AI_CONFIDENCE_THRESHOLD=0.40
